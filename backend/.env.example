DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Server-only Supabase values. Never put SUPABASE_SECRET_KEY in Flutter.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Django uses Postgres credentials for its database connection.
# This is the database password from Supabase Project Settings -> Database.
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Optional: auto-derived from SUPABASE_URL when omitted.
# SUPABASE_DB_HOST=db.YOUR_PROJECT.supabase.co
